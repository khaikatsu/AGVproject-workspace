{
  "name": "agv-web-backend",
  "version": "1.0.0",
  "description": "Backend Web (API + Database) cho he thong AGV - dung giua Dashboard va AGVServer.cpp",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-isolation=none ../tests/gateway.test.js ../tests/security.test.js ../tests/orders.test.js ../tests/warehouse-actions.test.js ../tests/warehouse-inventory.test.js ../tests/mission-model.test.js",
    "test:isolated": "node --test --test-isolation=process ../tests/gateway.test.js ../tests/security.test.js ../tests/orders.test.js ../tests/warehouse-actions.test.js ../tests/warehouse-inventory.test.js ../tests/mission-model.test.js",
    "test:missions:browser": "node ../tests/missions.browser.integration.js",
    "test:names:browser": "node ../tests/location-names.browser.integration.js",
    "test:reports:browser": "node ../tests/reports.browser.integration.js",
    "test:warehouse:browser": "node ../tests/warehouse.browser.integration.js",
    "test:rollback:browser": "node ../tests/warehouse-rollback.browser.integration.js",
    "test:vehicles:browser": "node ../tests/vehicle-cards.browser.integration.js",
    "test:records:browser": "node ../tests/record-delete.browser.integration.js",
    "test:shift:browser": "node ../tests/shift-start.browser.integration.js",
    "test:shift:restart": "node --test ../tests/shift-restart.integration.js",
    "test:hardening": "node ../tests/hardening.integration.js",
    "test:tls": "node ../tests/tls.integration.js",
    "test:system": "node ../tests/system.integration.js",
    "test:browser": "node ../tests/browser.integration.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
