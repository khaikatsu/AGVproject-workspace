# PowerShell / shell phải nạp các biến này; gateway không tự đọc tệp .env.
PORT=3000
HOST=127.0.0.1
AGV_WS_URL=ws://127.0.0.1:8080
AGV_COMMAND_TIMEOUT_MS=5000
# Mặc định DB nằm cạnh db.js. Khi test, luôn chỉ tới một file riêng.
# AGV_DB_PATH=C:/path/to/test.db
# AGV_RETENTION_DAYS=30
# AGV_RETENTION_ROWS=100000

# Khi nghe trên LAN (HOST=0.0.0.0), bắt buộc đặt token web ngẫu nhiên tối thiểu 32 ký tự.
# AGV_AUTH_TOKEN=thay-bang-token-ngau-nhien-toi-thieu-32-ky-tu
# AGV_ALLOWED_ORIGINS=https://agv.example.local
# Token riêng để gateway kết nối Core; không dùng lại AGV_AUTH_TOKEN.
# AGV_CORE_TOKEN=thay-bang-token-core-ngau-nhien-toi-thieu-32-ky-tu

# Bật HTTPS trực tiếp ở gateway. Cả hai đường dẫn phải được cấu hình cùng nhau.
# AGV_HTTPS_CERT=C:/path/to/server.crt
# AGV_HTTPS_KEY=C:/path/to/server.key
# AGV_SECURITY_REQUIRED=1
