{
  "folders": [{ "name": "AGV IoT Workspace", "path": "." }],
  "settings": {
    "files.encoding": "utf8",
    "files.exclude": { "**/node_modules": true, "**/.qa": true },
    "search.exclude": { "**/node_modules": true, "**/json.hpp": true, "**/.qa": true },
