FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ libmosquitto-dev libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY src ./src
COPY include ./include
RUN g++ -Iinclude -std=c++17 -O2 -pthread src/core/AGVserver.cpp -lmosquitto -lssl -lcrypto -o /agv_core
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libmosquitto1 libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 10001 --create-home agv && mkdir /data && chown agv /data
COPY --from=build /agv_core /usr/local/bin/agv_core
USER agv
WORKDIR /data
ENTRYPOINT ["agv_core"]
