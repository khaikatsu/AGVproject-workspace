{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MQTT v0.1 mutex grant/ack/release",
  "type": "object",
  "required": ["zone", "grant_id"],
  "additionalProperties": false,
  "properties": {
    "zone": {"type":"string", "pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "grant_id": {"type":"integer", "minimum":1, "maximum":2147483647}
  }
}
