{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGV current v0 command contract",
  "description": "Documented desired command shape. Runtime validation is not yet connected.",
  "type": "object",
  "required": [
    "cmd",
    "cmd_id"
  ],
  "properties": {
    "cmd": {
      "enum": [
        "GOTO",
        "STOP",
        "WAIT",
        "CHARGE_START",
        "RESET_FAULT",
        "NODE_ORDER",
        "LIFT_UP",
        "LIFT_DOWN"
      ]
    },
    "cmd_id": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "pass_through": {
      "type":"array","maxItems":31,"uniqueItems":true,
      "items":{"type":"integer","minimum":0,"maximum":30},
      "description":"Optional zero-based path indexes authorized to continue after actual RFID. Must exclude final node; firmware validates straight geometry and grants."
    },
    "route_cmd_id": {"type":"integer","minimum":1,"maximum":2147483647},
    "path_index": {"type":"integer","minimum":0,"maximum":32},
    "node": {"type":"string","minLength":1,"maxLength":7},
    "next_node": {"type":"string","minLength":1,"maxLength":7},
    "maneuver": {"enum":["STRAIGHT","LEFT","RIGHT","REVERSE","TURN_AROUND_RIGHT","STATION_TURN_RIGHT"]},
    "turn_crossings": {"type":"integer","minimum":0,"maximum":2},
    "reverse_after_turn": {"type":"boolean","default":false}
  },
  "allOf": [
    {"if":{"properties":{"cmd":{"enum":["LIFT_UP","LIFT_DOWN"]}}},"then":{"required":["node"],"properties":{"node":{"pattern":"^K[1-6]$"}}}},
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "GOTO"
          }
        }
      },
      "then": {
        "required": [
          "path",
          "target"
        ]
      }
    },
    {
      "if": {"properties":{"cmd":{"const":"NODE_ORDER"}}},
      "then": {
        "required":["route_cmd_id","path_index","node","next_node","maneuver","turn_crossings"],
        "allOf":[
          {"if":{"required":["reverse_after_turn"],"properties":{"reverse_after_turn":{"const":true}}},"then":{"properties":{"node":{"const":"GS1"},"next_node":{"const":"S1"},"maneuver":{"enum":["STRAIGHT","LEFT","RIGHT","TURN_AROUND_RIGHT"]}}}},
          {"if":{"properties":{"maneuver":{"enum":["LEFT","RIGHT","STATION_TURN_RIGHT"]}}},"then":{"properties":{"turn_crossings":{"const":1}}}},
          {"if":{"properties":{"maneuver":{"enum":["STRAIGHT","REVERSE"]}}},"then":{"properties":{"turn_crossings":{"const":0}}}},
          {"if":{"properties":{"maneuver":{"const":"TURN_AROUND_RIGHT"}}},"then":{"properties":{"turn_crossings":{"minimum":1}}}}
        ]
      }
    }
  ],
  "additionalProperties": true
}
